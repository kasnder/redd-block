{
  "name": "redd-design-tokens",
  "version": "1.0.0",
  "description": "Portable design tokens derived from the ReDD marketing site for ReDD Focus, ReDD Block, ReDD Do, and ReDD 2FA.",
  "sources": [
    "app/(main)/globals.css",
    "tailwind.config.ts",
    "components/DigitalFocusToolsSection.tsx",
    "components/ui/button.tsx",
    "components/ui/card.tsx",
    "components/ui/badge.tsx",
    "components/ui/breadcrumb.tsx",
    "components/ui/dropdown-menu.tsx"
  ],
  "notes": [
    "The current site has minor color drift between CSS variables and Tailwind hex aliases.",
    "The portable tokens below normalize those values for product adoption while preserving legacy aliases."
  ],
  "color": {
    "bg": {
      "canvas": "#faf8f5",
      "subtle": "#f1eee9",
      "card": "#ffffff",
      "darkSection": "#1e2d3e",
      "overlayCard": "rgba(255, 255, 255, 0.05)"
    },
    "text": {
      "primary": "#1e2d3e",
      "body": "#2c2c35",
      "muted": "#696977",
      "onDark": "#ffffff",
      "onDarkMuted": "rgba(255, 255, 255, 0.65)"
    },
    "border": {
      "subtle": "#e1dcd6",
      "onDark": "rgba(255, 255, 255, 0.10)"
    },
    "brand": {
      "coral": "#d4605a",
      "teal": "#2a9d8f",
      "blue": "#4a90e2",
      "navy": "#1e2d3e"
    },
    "accentSurface": {
      "coralSoft": "#faebea",
      "tealSoft": "#e5f5f3",
      "blueSoft": "#e8f1fa"
    },
    "legacyAliases": {
      "coralCssVar": "#d3625a",
      "tealCssVar": "#2a9d90",
      "blueCssVar": "#4b91e2",
      "reddPink": "#fbeae9",
      "reddDeepPink": "rgba(251, 234, 233, 0.70)"
    }
  },
  "typography": {
    "fontFamily": {
      "heading": "Georgia, \"Times New Roman\", serif",
      "body": "Inter, Arial, Helvetica, sans-serif",
      "utility": "Geist Sans, Inter, Arial, Helvetica, sans-serif",
      "mono": "Geist Mono, ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "roles": {
      "display": {
        "fontFamily": "{typography.fontFamily.heading}",
        "fontWeight": 700,
        "letterSpacing": "-0.01em"
      },
      "sectionHeading": {
        "fontFamily": "{typography.fontFamily.heading}",
        "fontWeight": 700,
        "letterSpacing": "-0.01em"
      },
      "body": {
        "fontFamily": "{typography.fontFamily.body}",
        "fontWeight": 400,
        "lineHeight": 1.6
      },
      "meta": {
        "fontFamily": "{typography.fontFamily.body}",
        "fontWeight": 400,
        "lineHeight": 1.4
      },
      "button": {
        "fontFamily": "{typography.fontFamily.body}",
        "fontWeight": 600,
        "lineHeight": 1.2
      },
      "badge": {
        "fontFamily": "{typography.fontFamily.body}",
        "fontWeight": 500,
        "lineHeight": 1.2
      }
    }
  },
  "spacing": {
    "base": 8,
    "scalePx": {
      "xs": 4,
      "sm": 8,
      "md": 12,
      "lg": 16,
      "xl": 24,
      "2xl": 32,
      "3xl": 48,
      "4xl": 64
    },
    "layout": {
      "pageMaxWidth": 1200,
      "pagePaddingX": 24
    }
  },
  "radius": {
    "base": 8,
    "button": 8,
    "card": 12,
    "pill": 999
  },
  "shadow": {
    "card": "0 1px 2px rgba(0, 0, 0, 0.08)",
    "cardHover": "0 8px 24px rgba(30, 45, 62, 0.10)",
    "button": "0 1px 2px rgba(0, 0, 0, 0.08)"
  },
  "motion": {
    "duration": {
      "fastMs": 200,
      "defaultMs": 300
    },
    "easing": {
      "standard": "ease",
      "emphasis": "ease-in-out"
    },
    "patterns": {
      "cardExpansion": {
        "durationMs": 300,
        "easing": "ease"
      },
      "buttonHover": {
        "durationMs": 200,
        "easing": "ease"
      }
    }
  },
  "components": {
    "button": {
      "primary": {
        "background": "{color.brand.teal}",
        "foreground": "#ffffff",
        "borderRadius": "{radius.button}",
        "font": "{typography.roles.button}"
      },
      "outline": {
        "background": "{color.bg.card}",
        "foreground": "{color.text.primary}",
        "borderColor": "{color.border.subtle}",
        "borderRadius": "{radius.button}",
        "font": "{typography.roles.button}"
      },
      "link": {
        "foreground": "{color.brand.blue}",
        "textDecoration": "underline"
      }
    },
    "card": {
      "light": {
        "background": "{color.bg.card}",
        "foreground": "{color.text.body}",
        "borderColor": "{color.border.subtle}",
        "borderRadius": "{radius.card}"
      },
      "darkSection": {
        "background": "{color.bg.overlayCard}",
        "foreground": "{color.text.onDark}",
        "borderColor": "{color.border.onDark}",
        "borderRadius": "{radius.card}"
      }
    },
    "badge": {
      "neutral": {
        "background": "{color.bg.subtle}",
        "foreground": "{color.text.primary}",
        "borderColor": "{color.border.subtle}",
        "borderRadius": "{radius.pill}"
      }
    },
    "breadcrumb": {
      "default": {
        "foreground": "{color.text.muted}",
        "currentForeground": "{color.text.primary}"
      }
    }
  },
  "adoptionRules": {
    "mustMatchExactly": [
      "core brand palette",
      "heading vs body font roles",
      "button hierarchy",
      "badge tone",
      "card softness"
    ],
    "mayAdaptPerPlatform": [
      "UI density",
      "native widget styling",
      "toolbar sizing",
      "popup layout constraints"
    ],
    "shouldRemainProductSpecific": [
      "logos",
      "feature illustrations",
      "task- or security-specific flows",
      "platform permission patterns"
    ]
  }
}
