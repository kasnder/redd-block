# App Store submission lane for CI (Release build / App Store submission workflows).
#
# Uploads the IPA built by scripts/ios-appstore-build.sh, stamps the iOS
# "What's new" (from scripts/changelog-to-store-whats-new.js --platform ios),
# and submits for review with automatic release after approval — the App Store
# equivalent of scripts/submit-microsoft-store.ps1.
#
# Auth: App Store Connect API key via env vars (see docs/app-store-ci.md):
#   APP_STORE_CONNECT_API_KEY_ID          Key ID
#   APP_STORE_CONNECT_API_ISSUER_ID       Issuer ID
#   APP_STORE_CONNECT_API_KEY_P8          base64 of the .p8 private key
#
# Usage:
#   fastlane ios submit_app_store version:3.8.5 ipa:"path/to.ipa" notes:whats_new_ios.txt
#   # Retry with an already-uploaded binary (skip upload, pick build by number):
#   fastlane ios submit_app_store version:3.8.5 notes:whats_new_ios.txt build_number:3.8.5

default_platform(:ios)

platform :ios do
  desc "Upload IPA + What's new to App Store Connect and submit for review"
  lane :submit_app_store do |options|
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_P8"),
      is_key_content_base64: true
    )

    # fastlane runs lanes from the fastlane/ directory, so paths passed from
    # the repo root won't resolve as-is — fall back to the parent directory.
    resolve_path = lambda do |raw|
      p = raw.to_s.strip
      return nil if p.empty?
      return p if File.exist?(p)
      from_root = File.expand_path(p, "..")
      File.exist?(from_root) ? from_root : p
    end

    version = options.fetch(:version)
    notes_path = resolve_path.call(options.fetch(:notes))
    UI.user_error!("What's new file not found: #{options[:notes]}") unless notes_path && File.exist?(notes_path)
    notes = File.read(notes_path).strip
    UI.user_error!("What's new file is empty — nothing iOS-facing to submit") if notes.empty?

    # Promotional text does not reliably persist across new versions, so we
    # stamp it explicitly on every submission.
    promotional_text =
      "Free your mind. ReDD Blocker helps you block distracting apps and " \
      "websites — backed by 10+ years of our award-winning research at the " \
      "University of Oxford."

    ipa = resolve_path.call(options[:ipa])
    UI.user_error!("IPA not found: #{options[:ipa]}") if !options[:ipa].to_s.strip.empty? && !File.exist?(ipa.to_s)
    build_number = options[:build_number].to_s.strip
    build_number = nil if build_number.empty?

    # App Store Connect requires whatsNew on the real listing locale. Passing
    # only "default" never stamps it; using the wrong locale (e.g. en-US) can
    # activate an empty extra localization and break submit. ReDD Blocker's
    # primary language is English (U.K.).
    locale = "en-GB"

    deliver(
      api_key: api_key,
      app_identifier: "com.reddblock",
      app_version: version,
      ipa: ipa,
      skip_binary_upload: ipa.nil?,
      build_number: build_number,
      languages: [locale],
      release_notes: { locale => notes },
      promotional_text: { locale => promotional_text },
      submit_for_review: true,
      automatic_release: true,
      skip_screenshots: true,
      skip_metadata: false,
      force: true, # no interactive HTML preview in CI
      run_precheck_before_submit: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      }
    )
  end
end
