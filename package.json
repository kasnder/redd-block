{
  "name": "redd-block",
  "version": "0.3.0",
  "description": "ReDD Block - block distracting websites and apps to stay focused",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "predev": "node scripts/predev.js",
    "dev": "npm run predev && electron . --dev",
    "build": "node build.js",
    "prebuild:mac": "npm run compile:helper:mac",
    "build:mac": "npm run prebuild:mac && node build.js --mac",
    "prebuild:win": "npm run compile:helper:win",
    "build:win": "npm run prebuild:win && node build.js --win",
    "prebuild:linux": "npm run compile:helper:linux",
    "build:linux": "npm run prebuild:linux && node build.js --linux",
    "postinstall": "electron-builder install-app-deps",
    "compile:helper:mac": "pkg helper/redd-block-helper.js -t node18-macos-arm64 -o helper/dist/redd-block-helper-arm64 && pkg helper/redd-block-helper.js -t node18-macos-x64 -o helper/dist/redd-block-helper-x64 && lipo -create -output helper/dist/redd-block-helper helper/dist/redd-block-helper-arm64 helper/dist/redd-block-helper-x64",
    "compile:helper:win": "pkg helper/redd-block-helper.js -t node18-win-x64 -o helper/dist/redd-block-helper-win.exe",
    "compile:helper:linux": "pkg helper/redd-block-helper.js -t node18-linux-x64 -o helper/dist/redd-block-helper-linux",
    "compile:helper": "npm run compile:helper:mac",
    "generate:assets": "node scripts/generate-appx-assets.js",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:mac": "./scripts/build-mac.sh",
    "build:helper": "cd helper-daemon && cargo build --release && cp target/release/redd-block-helper target/release/redd-block-helper-aarch64-apple-darwin",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "vite:preview": "vite preview"
  },
  "keywords": [
    "blocker",
    "focus",
    "productivity",
    "electron",
    "website-blocker",
    "app-blocker"
  ],
  "author": {
    "name": "The Reduce Digital Distraction Project",
    "email": "team@reddfocus.org"
  },
  "license": "CC-BY-NC-ND-3.0",
  "dependencies": {
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-shell": "^2.3.4",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "emoji-picker-element": "^1.28.1",
    "sudo-prompt": "^9.2.1"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@tauri-apps/cli": "^2.9.6",
    "dotenv": "^17.2.3",
    "electron": "^25.9.8",
    "electron-builder": "^26.0.12",
    "electron-icon-builder": "^2.0.1",
    "pkg": "^5.8.1",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "vite": "^7.3.1"
  }
}