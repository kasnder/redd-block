#!/bin/bash
# postinstall — runs as root after the .pkg payload is laid down.
#
# Auto-launches the new app for the user who triggered the install,
# mirroring the Windows NSIS finish-page "Run ReDD Blocker" checkbox.
# Without this, macOS users who installed via .pkg would be left staring
# at the Installer.app "Install Successful" screen with no clear next step.
# Also removes legacy `/Applications/ReDD Block.app` and `/Applications/Fristed.app`
# bundles so upgrades don't leave duplicate app icons in Applications, and scrubs
# stale user LaunchAgents (e.g. `Fristed.plist`) so login items don't point at
# deleted app paths before the new build re-registers autostart.

set +e

LOG=/var/log/redd-block-pkg-postinstall.log
exec > >(tee -a "$LOG") 2>&1
echo "=== postinstall $(date '+%F %T') ==="

LEGACY_REDD_BLOCK_APP_PATH='/Applications/ReDD Block.app'
FRISTED_APP_PATH='/Applications/Fristed.app'

if [ -d "$LEGACY_REDD_BLOCK_APP_PATH" ]; then
    rm -rf "$LEGACY_REDD_BLOCK_APP_PATH" && echo "removed legacy app: $LEGACY_REDD_BLOCK_APP_PATH"
fi
if [ -d "$FRISTED_APP_PATH" ]; then
    rm -rf "$FRISTED_APP_PATH" && echo "removed legacy app: $FRISTED_APP_PATH"
fi

# Block page SVG must be readable by Safari (file:// loads as the user).
BLOCKED_RES='/Applications/ReDD Blocker.app/Contents/Resources/blocked'
if [ -d "$BLOCKED_RES" ]; then
    chmod 644 "$BLOCKED_RES"/* 2>/dev/null && echo "fixed block page resource permissions"
fi

# The Installer.app stashes the invoking user in $USER (their actual
# console user, not root). Use it to launch the GUI in their session.
TARGET_USER="${USER:-$(stat -f '%Su' /dev/console)}"
TARGET_UID=$(id -u "$TARGET_USER" 2>/dev/null)

if [ -z "$TARGET_UID" ]; then
    echo "could not resolve uid for $TARGET_USER; skipping auto-launch"
    exit 0
fi

# Remove stale launch-at-login plists before opening the new app.
# Release builds self-heal autostart on every launch, but a leftover
# `Fristed.plist` (or a redd-block plist pointing at a deleted .app)
# would still fire at login and error until the user opens ReDD Blocker.
scrub_stale_autostart_plists_for_user() {
    local user="$1"
    local uid="$2"
    local home
    home=$(dscl . -read "/Users/$user" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
    [ -z "$home" ] && home="/Users/$user"
    local dir="$home/Library/LaunchAgents"
    [ -d "$dir" ] || return 0

    for plist in "$dir"/*.plist; do
        [ -f "$plist" ] || continue
        local base lower remove=0
        base=$(basename "$plist")
        lower=$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]')
        if [[ "$lower" == *reddblock* ]] || [[ "$lower" == *redd-block* ]]; then
            remove=1
        elif [[ "$lower" == "fristed.plist" ]]; then
            remove=1
        elif grep -q '/Applications/Fristed.app' "$plist" 2>/dev/null; then
            remove=1
        elif grep -q '/Applications/ReDD Block.app' "$plist" 2>/dev/null; then
            remove=1
        fi
        if [ "$remove" = "1" ]; then
            launchctl bootout "gui/$uid" "$plist" 2>/dev/null || true
            rm -f "$plist" && echo "removed stale LaunchAgent: $plist"
        fi
    done
}
scrub_stale_autostart_plists_for_user "$TARGET_USER" "$TARGET_UID"

# launchctl asuser runs the command in the target user's bootstrap
# domain so the GUI shows up on their session.
launchctl asuser "$TARGET_UID" /usr/bin/open '/Applications/ReDD Blocker.app' || \
    sudo -u "$TARGET_USER" /usr/bin/open '/Applications/ReDD Blocker.app'

echo "postinstall launched ReDD Blocker for $TARGET_USER"
exit 0
