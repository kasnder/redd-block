{
    "build": {
        "features": [
            "desktop"
        ]
    },
    "bundle": {
        "windows": {
            "webviewInstallMode": {
                "type": "embedBootstrapper",
                "silent": true
            },
            "signCommand": {
                "cmd": "powershell",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "../scripts/sign.ps1",
                    "%1"
                ]
            },
            "nsis": {
                "languages": [
                    "English"
                ],
                "customLanguageFiles": {
                    "English": "./windows/English.nsh"
                },
                "installerHooks": "./windows/hooks.nsh"
            }
        }
    }
}