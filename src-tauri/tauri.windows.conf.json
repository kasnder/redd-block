{
    "build": {
        "features": [
            "desktop"
        ]
    },
    "bundle": {
        "windows": {
            "webviewInstallMode": {
                "type": "embedBootstrapper",
                "silent": true
            },
            "signCommand": {
                "cmd": "cmd",
                "args": [
                    "/c",
                    "call",
                    "windows\\sign-bundle.cmd",
                    "%1"
                ]
            },
            "nsis": {
                "languages": [
                    "English"
                ],
                "customLanguageFiles": {
                    "English": "./windows/English.nsh"
                },
                "installerHooks": "./windows/hooks.nsh"
            }
        }
    }
}