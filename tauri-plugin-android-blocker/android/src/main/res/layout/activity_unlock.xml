<?xml version="1.0" encoding="utf-8"?>
<!-- Native friction gate, visually mirroring the webview pause modal
     (src/index.html #pause-modal in mobile-fullscreen mode):
     header (back + serif title) → room chip → status line → PAUSE FOR /
     RESTARTS AT → challenge instruction / text / current word / input /
     progress bar → Cancel + primary pause button. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/gate_bg">

    <LinearLayout
        android:id="@+id/gate_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Header: back button + title (matches .mobile-modal-header) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/gate_back_btn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/gate_back"
                android:src="@drawable/ic_gate_back" />

            <TextView
                android:id="@+id/gate_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/gate_title"
                android:textColor="@color/gate_text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="serif" />
        </LinearLayout>

        <!-- Room chip: emoji + blocklist name (matches .start-confirm-room-chip) -->
        <LinearLayout
            android:id="@+id/gate_room_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/gate_chip_bg"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">

            <TextView
                android:id="@+id/gate_chip_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:text="🎯" />

            <TextView
                android:id="@+id/gate_chip_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:textColor="@color/gate_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Status line: what is being blocked right now -->
        <TextView
            android:id="@+id/gate_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/gate_text_muted"
            android:textSize="14sp" />

        <!-- PAUSE FOR / RESTARTS AT row (matches .pause-duration-section) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/gate_card_bg"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gate_pause_for"
                    android:textColor="@color/gate_text_muted"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/gate_pause_days"
                        android:layout_width="42dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/gate_input_bg"
                        android:inputType="number"
                        android:gravity="center"
                        android:maxLength="3"
                        android:padding="8dp"
                        android:text="0"
                        android:textColor="@color/gate_text_primary"
                        android:textSize="15sp"
                        android:importantForAutofill="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/gate_unit_days"
                        android:textColor="@color/gate_text_muted"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/gate_pause_hours"
                        android:layout_width="42dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/gate_input_bg"
                        android:inputType="number"
                        android:gravity="center"
                        android:maxLength="2"
                        android:padding="8dp"
                        android:text="0"
                        android:textColor="@color/gate_text_primary"
                        android:textSize="15sp"
                        android:importantForAutofill="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/gate_unit_hours"
                        android:textColor="@color/gate_text_muted"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/gate_pause_minutes"
                        android:layout_width="42dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/gate_input_bg"
                        android:inputType="number"
                        android:gravity="center"
                        android:maxLength="4"
                        android:padding="8dp"
                        android:text="10"
                        android:textColor="@color/gate_text_primary"
                        android:textSize="15sp"
                        android:importantForAutofill="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/gate_unit_minutes"
                        android:textColor="@color/gate_text_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="10dp"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gate_restarts_at"
                    android:textColor="@color/gate_text_muted"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/gate_restart_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/gate_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/gate_next_day_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/gate_next_day"
                    android:textColor="@color/gate_accent"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Challenge instruction (matches .override-challenge-instruction) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/gate_instruction"
            android:textColor="@color/gate_text_secondary"
            android:textSize="14sp" />

        <!-- Challenge phrase (matches .challenge-text) -->
        <TextView
            android:id="@+id/gate_challenge_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/gate_challenge_bg"
            android:padding="14dp"
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:lineSpacingExtra="6dp"
            android:textColor="@color/gate_text_secondary" />

        <!-- Word x of y (matches .challenge-word-progress) -->
        <TextView
            android:id="@+id/gate_word_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/gate_text_muted"
            android:textSize="12sp" />

        <!-- Current word (matches .challenge-current-word) -->
        <TextView
            android:id="@+id/gate_current_word"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/gate_word_bg"
            android:padding="14dp"
            android:gravity="center"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/gate_accent" />

        <!-- Input (matches .challenge-word-input) -->
        <EditText
            android:id="@+id/gate_word_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/gate_input_bg"
            android:hint="@string/gate_input_hint"
            android:textColorHint="@color/gate_text_muted"
            android:textColor="@color/gate_text_primary"
            android:textSize="16sp"
            android:padding="14dp"
            android:inputType="textVisiblePassword|textNoSuggestions"
            android:imeOptions="actionDone"
            android:maxLines="1"
            android:importantForAutofill="no" />

        <!-- Progress bar (matches .challenge-progress) -->
        <ProgressBar
            android:id="@+id/gate_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="12dp"
            android:max="1000"
            android:progressDrawable="@drawable/gate_progress" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="18dp" />

        <!-- Buttons (matches .modal-buttons.start-confirm-actions) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/gate_cancel_btn"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/gate_btn_cancel"
                android:text="@string/gate_cancel"
                android:textAllCaps="false"
                android:textColor="@color/gate_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/gate_confirm_btn"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1.4"
                android:layout_marginStart="12dp"
                android:background="@drawable/gate_btn_primary"
                android:drawableStart="@drawable/ic_gate_pause"
                android:drawablePadding="8dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:gravity="center"
                android:enabled="false"
                android:alpha="0.5"
                android:text="@string/gate_pause_button"
                android:textAllCaps="false"
                android:textColor="@color/gate_primary_btn_text"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
