<?xml version="1.0" encoding="utf-8"?>
<!-- Native friction gate (UnlockActivity) palette. Values mirror the webview's
     ReDD design tokens in src/styles.css `:root` so the native gate is visually
     indistinguishable from the web pause modal. -->
<resources>
    <color name="gate_bg">#F7F5F0</color>                 <!-- redd-cream -->
    <color name="gate_card">#FFFFFF</color>               <!-- redd-card -->
    <color name="gate_warm_grey">#F1EEE9</color>          <!-- redd-warm-grey -->
    <color name="gate_text_primary">#1E2D3E</color>       <!-- redd-navy -->
    <color name="gate_text_secondary">#2C2C35</color>     <!-- redd-body -->
    <color name="gate_text_muted">#696977</color>         <!-- redd-muted -->
    <color name="gate_border">#E1DCD6</color>             <!-- redd-border -->
    <color name="gate_accent">#2A9D8F</color>             <!-- redd-teal -->
    <color name="gate_danger">#D4605A</color>             <!-- redd-coral -->
    <color name="gate_primary_btn">#1E2D3E</color>        <!-- primary-btn-bg (navy) -->
    <color name="gate_primary_btn_text">#FFFFFF</color>
    <color name="gate_progress_track">#E1DCD6</color>
</resources>
