<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/block_overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/block_canvas"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- Full-bleed opaque layer so blocked app content cannot show through. -->
    <View
        android:id="@+id/block_overlay_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/block_canvas"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/block_overlay_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/block_overlay_dismiss"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/block_overlay_close"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="@color/block_text_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/block_overlay_header_logo"
                    android:layout_width="@dimen/block_header_logo_size"
                    android:layout_height="@dimen/block_header_logo_size"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/block_overlay_brand"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/block_overlay_brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/block_overlay_brand"
                    android:textColor="@color/block_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="40dp"
                android:layout_height="40dp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/block_canvas"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/block_card_background"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/block_card_padding">

                    <FrameLayout
                        android:layout_width="@dimen/block_hero_size"
                        android:layout_height="@dimen/block_hero_size"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:id="@+id/block_overlay_hero_icon"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/block_oval"
                            android:backgroundTint="@color/block_hero_ring"
                            android:contentDescription="@null"
                            android:padding="12dp"
                            android:scaleType="centerInside" />

                        <FrameLayout
                            android:layout_width="@dimen/block_badge_size"
                            android:layout_height="@dimen/block_badge_size"
                            android:layout_gravity="top|start"
                            android:background="@drawable/block_oval"
                            android:backgroundTint="@color/block_badge_bg"
                            android:padding="6dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_shield_badge" />
                        </FrameLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/block_overlay_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:text="@string/block_overlay_title"
                        android:textColor="@color/block_text_primary"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/block_overlay_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textColor="@color/block_text_secondary"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:id="@+id/block_overlay_pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/block_pill_background"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:id="@+id/block_overlay_pill_emoji"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/block_overlay_pill_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/block_pill_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="vertical"
                        android:paddingTop="18dp"
                        android:showDividers="middle">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="10dp"
                            android:background="@color/block_divider" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/block_overlay_target_label"
                                style="@style/BlockDetailLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <TextView
                                android:id="@+id/block_overlay_target_value"
                                style="@style/BlockDetailValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:gravity="end"
                                android:maxLines="2" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/BlockDetailLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/block_overlay_blocklist_label" />

                            <TextView
                                android:id="@+id/block_overlay_blocklist_value"
                                style="@style/BlockDetailValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:gravity="end"
                                android:maxLines="1" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/block_overlay_ends_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/block_overlay_ends_label"
                                style="@style/BlockDetailLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/block_overlay_ends_in" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/block_overlay_ends_countdown"
                                    style="@style/BlockDetailValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />

                                <TextView
                                    android:id="@+id/block_overlay_ends_at_suffix"
                                    style="@style/BlockDetailValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/block_overlay_started_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <TextView
                                style="@style/BlockDetailLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/block_overlay_started_at" />

                            <TextView
                                android:id="@+id/block_overlay_started_value"
                                style="@style/BlockDetailValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:gravity="end"
                                android:maxLines="1" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/block_overlay_close"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/block_pill_background"
                    android:minHeight="52dp"
                    android:text="@string/block_overlay_close"
                    android:textAllCaps="false"
                    android:textColor="@color/block_button_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
